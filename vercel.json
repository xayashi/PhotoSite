{
    "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "images": {
        "sizes": [
            600,
            640,
            750,
            828,
            1080,
            1200,
            1920,
            2048,
            3840
        ],
        "formats": [
            "image/avif",
            "image/webp"
        ],
        "minimumCacheTTL": 86400,
        "dangerouslyAllowSVG": true
    }
}