// --- COMPONENT: HORIZONTAL LANDING (FILMSTRIP) ---
export default function PortfolioApp() {
  const containerRef = useRef(null);
  const [scrollPos, setScrollPos] = useState(0);
  const [skew, setSkew] = useState(0);
  
  // Interaction States
  const [focusedId, setFocusedId] = useState(null); // Step 1: Clicked once (Enlarged)
  const [selectedProject, setSelectedProject] = useState(null); // Step 2: Clicked View (Full Screen)
  
  useEffect(() => {
    let currentScroll = 0;
    let targetScroll = 0;
    let currentSkew = 0;
    let animationFrame;

    const handleWheel = (e) => {
      if (selectedProject) return; 
      
      // If user scrolls, we should probably dismiss the focused state
      if (Math.abs(e.deltaY) > 5) setFocusedId(null);

      targetScroll += e.deltaY;
      const maxScroll = (projects.length * 450) - window.innerWidth + 400; 
      targetScroll = Math.max(0, Math.min(targetScroll, maxScroll));
    };

    const animate = () => {
      const ease = 0.08;
      const diff = targetScroll - currentScroll;
      currentScroll += diff * ease;
      const velocity = diff * ease;
      const skewTarget = velocity * 0.15; 
      currentSkew += (skewTarget - currentSkew) * 0.1; 

      setScrollPos(currentScroll);
      setSkew(currentSkew);
      animationFrame = requestAnimationFrame(animate);
    };

    window.addEventListener('wheel', handleWheel);
    animate();

    return () => {
      window.removeEventListener('wheel', handleWheel);
      cancelAnimationFrame(animationFrame);
    };
  }, [selectedProject]);

  const handleCardClick = (id) => {
      if (focusedId === id) {
          setFocusedId(null); // Toggle off if clicked again (optional, or do nothing)
      } else {
          setFocusedId(id);
      }
  };

  const handleViewClick = (e, project) => {
      e.stopPropagation(); // Prevent parent click
      setSelectedProject(project);
      setFocusedId(null); // Reset focus for when we come back
  };

  return (
    <div className="h-screen w-screen bg-[#0a0a0a] overflow-hidden text-white font-sans">
      
      {/* LANDING NAV */}
      <nav className="fixed top-0 left-0 w-full p-8 flex justify-between items-center z-40 mix-blend-difference pointer-events-none">
        <div className="text-xl font-bold tracking-tighter flex items-center gap-2 pointer-events-auto">
            <Camera size={20}/> GRAIN.
        </div>
        <div className="text-xs tracking-[0.2em] uppercase opacity-60 hidden md:block">
            Scroll to Explore
        </div>
      </nav>

      {/* HORIZONTAL CONTENT */}
      <div 
        className={`h-full flex items-center pl-[20vw] transition-all duration-700 ease-in-out ${selectedProject ? 'opacity-0 scale-95 pointer-events-none' : 'opacity-100 scale-100'}`}
        style={{ transform: `translate3d(-${scrollPos}px, 0, 0)` }}
      >
        {projects.map((item) => {
          const isFocused = focusedId === item.id;

          return (
            <div 
              key={item.id}
              onClick={() => handleCardClick(item.id)}
              className={`relative flex-shrink-0 mx-4 md:mx-12 transition-all duration-500 ease-out cursor-pointer
                ${isFocused ? 'z-20 scale-110' : 'z-0 scale-100 hover:opacity-100 opacity-60'}
              `}
              style={{ 
                width: '40vh', 
                height: '60vh',
                transform: isFocused ? 'skewX(0deg)' : `skewX(${-skew}deg)` // Remove skew when focused for clarity
              }}
            >
                {/* Image Container */}
                <div className="w-full h-full overflow-hidden relative shadow-2xl">
                    <img 
                        src={item.cover} 
                        alt={item.title}
                        className={`w-full h-full object-cover transition-all duration-700 
                            ${isFocused ? 'scale-100 grayscale' : 'scale-110 grayscale'}
                        `} 
                        // Note: We keep it grayscale in focus state to make the color transition in detail view pop
                    />
                    
                    {/* The "View" Prompt - Only visible when focused */}
                    <div 
                        className={`absolute inset-0 bg-black/40 backdrop-blur-[2px] flex items-center justify-center transition-opacity duration-500
                        ${isFocused ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
                    >
                        <button 
                            onClick={(e) => handleViewClick(e, item)}
                            className="group flex flex-col items-center gap-2"
                        >
                            <div className="w-20 h-20 rounded-full border border-white/30 flex items-center justify-center bg-white/10 backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300">
                                <span className="text-xs font-bold tracking-widest">VIEW</span>
                            </div>
                            <div className="flex items-center gap-2 text-xs uppercase tracking-widest opacity-0 transform translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
                                Open Project <MoveRight size={12} />
                            </div>
                        </button>
                    </div>
                </div>

                {/* Typography */}
                <div className={`absolute -bottom-16 left-0 transition-all duration-500 ${isFocused ? 'translate-y-4 opacity-100' : 'opacity-50'}`}>
                    <p className="text-xs text-white/50 mb-1 font-mono">{item.subtitle}</p>
                    <h2 className="text-5xl md:text-7xl font-serif text-transparent stroke-text">
                        {item.title}
                    </h2>
                </div>

                {/* Background Number */}
                <div className="absolute -top-20 -left-10 text-[10rem] font-bold text-white/5 z-[-1] select-none font-serif">
                    0{item.id}
                </div>
            </div>
          );
        })}
        
        <div className="w-[50vw] flex-shrink-0 text-white/20 text-sm tracking-widest uppercase flex items-center">
            End of Reel
        </div>
      </div>

      {/* DETAIL PAGE OVERLAY */}
      {selectedProject && (
        <ProjectDetail 
            project={selectedProject} 
            onClose={() => setSelectedProject(null)} 
        />
      )}

      <style jsx>{`
        .stroke-text { -webkit-text-stroke: 1px rgba(255,255,255,0.8); }
      `}</style>
    </div>
  );
}